{
  "name": "amun",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Amun: local-first agentic product management on Firstmate and the Paseo daemon",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/highlight",
    "packages/relay",
    "packages/protocol",
    "packages/client",
    "packages/plugin",
    "packages/server",
    "packages/cli",
    "packages/contracts",
    "packages/domain",
    "packages/theme",
    "packages/amun-ui",
    "packages/desktop"
  ],
  "scripts": {
    "build:paseo": "npm run build -w @getpaseo/highlight && npm run build -w @getpaseo/relay && npm run build -w @getpaseo/protocol && npm run build -w @getpaseo/client && npm run build -w @getpaseo/plugin",
    "build:server": "npm run build:paseo && npm run build -w @getpaseo/server && npm run build -w @getpaseo/cli",
    "typecheck": "npm run build:server && npm run typecheck:paseo && npm run typecheck:amun",
    "typecheck:paseo": "npm run typecheck -w @getpaseo/protocol -w @getpaseo/client -w @getpaseo/plugin -w @getpaseo/server -w @getpaseo/desktop",
    "typecheck:amun": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:server": "npm run test:unit -w @getpaseo/server",
    "start": "npm run start -w @getpaseo/server",
    "lint": "eslint packages/contracts packages/domain packages/theme packages/amun-ui",
    "format:check": "prettier --check docs packages/contracts packages/domain packages/theme packages/amun-ui",
    "tokens:build": "node --experimental-strip-types scripts/build-tokens.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.14",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "44.2.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.14.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "oxlint-tsgolint": "^0.22.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "react-dom": "19.2.3",
    "style-dictionary": "^5.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.6",
    "ws": "^8.20.0"
  },
  "overrides": {
    "zod": "4.4.3"
  }
}
