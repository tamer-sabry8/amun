{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "**/node_modules",
    "**/dist"
  ],
  "include": [
    "packages/contracts/**/*.ts",
    "packages/domain/**/*.ts",
    "packages/theme/**/*.ts",
    "packages/amun-ui/**/*.ts",
    "packages/amun-ui/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
