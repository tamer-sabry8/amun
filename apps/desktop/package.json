{
  "name": "@amun/desktop",
  "productName": "Amun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "vite build && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts && vite build --config vite.diff-worker.config.ts",
    "start": "pnpm build && electron-forge start",
    "package": "pnpm build && electron-forge package"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@types/better-sqlite3": "9.6.0",
    "electron": "45.2.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1"
  }
}
